# ==============================================================================
# LLM 后端切换开关: http (云端官方 API) | vllm (服务器本地部署 OpenAI 兼容接口)
# ==============================================================================
LLM_BACKEND=http

# 1. 云端 DeepSeek 官方 API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

# 2. 本地 / 服务器 vLLM OpenAI 兼容接口（上服务器切回用）
LLM_VLLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_VLLM_API_KEY=sjk_vllm_dsv4flash0731
LLM_VLLM_MODEL=deepseek-v4-flash-0731
LLM_VLLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
